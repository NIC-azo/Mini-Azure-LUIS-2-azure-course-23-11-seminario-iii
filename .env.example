# ====================================================================
# Plantilla de Variables de Entorno - Mini-Azure LUIS v2
# Copiar este archivo a .env y configurar los valores correspondientes
# NUNCA subir el archivo .env real con credenciales de producción a Git
# ====================================================================

# --------------------------------------------------------------------
# 1. Configuración del Servidor Backend (FastAPI)
# --------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
CONFIDENCE_THRESHOLD=0.65
DATASET_PATH=/app/data/dataset_agro.csv
MODEL_DIR=/app/models
STATS_FILE=/app/data/historial.json

# --------------------------------------------------------------------
# 2. Seguridad, Autenticación y RBAC (Tokens JWT)
# --------------------------------------------------------------------
# Clave secreta criptográfica para firmar y verificar tokens JWT (generar con openssl rand -hex 32)
JWT_SECRET_KEY=clave_secreta_jwt_mini_azure_luis_v2_segura_2026_agro
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Credenciales de Usuarios RBAC
# Perfil OPERADOR (Acceso exclusivo a entender comandos y analizar texto)
OPERADOR_USER=operador_ica
OPERADOR_PASS=operador_pass_2026

# Perfil SUPERVISOR (Acceso total: estadísticas, reinicio de KPIs y análisis)
SUPERVISOR_USER=supervisor_ica
SUPERVISOR_PASS=supervisor_pass_2026

# --------------------------------------------------------------------
# 3. Configuración del Cliente / Dashboard (Streamlit / Frontend)
# --------------------------------------------------------------------
# URL pública o remota de la API para despliegue Cloud (ej. https://mini-azure-luis-api.onrender.com)
# Si está vacío o en local, se utilizará TARGET_SERVER_IP y SERVER_PORT
API_PUBLIC_URL=http://localhost:8001

# Fallback para entorno local o red LAN
TARGET_SERVER_IP=127.0.0.1
